{
  "name": "qlsv2",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n BACKEND,FRONTEND -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix frontend/backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run build:frontend",
    "build:backend": "npm --prefix frontend/backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start": "concurrently -k -n BACKEND,FRONTEND -c blue,green \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm --prefix frontend/backend run start",
    "start:frontend": "npm --prefix frontend run start",
    "install:all": "npm install && npm install --prefix frontend",
    "build:vercel": "cd frontend && next build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "next": "^16.0.1"
  }
}
